@using System.Globalization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<AppResources> Localizer
@model TimeDayPartialViewModel

<article id="time-day-@Model.Day.Id"
         class="panel time-day-card"
         data-date="@Model.Day.Date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">
    <header class="time-day-header">
        <div class="time-day-heading">
            <h2>@Model.Day.Date.ToString("dd/MM/yy", CultureInfo.InvariantCulture)</h2>
            <span class="time-day-total">@Localizer["Time_Total"]: @Model.Day.TotalTimeSpent</span>
        </div>
        <form method="post"
              action="/projects/@Model.ProjectId/time/days/@Model.Day.Id/delete"
              data-confirm-form
              data-confirm-title="@Localizer["Time_DeleteDayTitle"]"
              data-confirm-message="@Localizer["Time_DeleteDayMessage", Model.Day.Date.ToString("dd/MM/yy", CultureInfo.InvariantCulture)]"
              data-confirm-label="@Localizer["Index_Delete"]"
              data-confirm-danger="true">
            @Html.AntiForgeryToken()
            <input type="hidden" name="month" value="@Model.MonthKey" />
            <button class="icon-button"
                    type="submit"
                    title="@Localizer["Time_DeleteDay"]"
                    aria-label="@Localizer["Time_DeleteDay"]">×</button>
        </form>
    </header>

    <div class="time-entry-list">
        @foreach (var entry in Model.Day.Entries)
        {
            <div class="time-entry-row">
                <form method="post"
                      action="/projects/@Model.ProjectId/time/entries/@entry.Id/update"
                      class="time-entry-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="month" value="@Model.MonthKey" />

                    <label class="field time-entry-spent">
                        <span>@Localizer["Time_TimeSpent"]</span>
                        <input name="timeSpent"
                               value="@entry.TimeSpent"
                               title="@Localizer["Edit_TimeFormatHint"]"
                               required />
                    </label>

                    <label class="field time-entry-task">
                        <span>@Localizer["Time_Task"]</span>
                        <input type="hidden"
                               name="noteId"
                               value="@(entry.NoteId?.ToString() ?? "")"
                               data-time-task-note-id />
                        <input name="taskTitle"
                               value="@entry.TaskTitle"
                               maxlength="240"
                               list="timeTaskOptions"
                               placeholder="@Localizer["Time_TaskPlaceholder"]"
                               autocomplete="off"
                               data-time-task-input />
                    </label>

                    <label class="field time-entry-comment">
                        <span>@Localizer["Time_Comment"]</span>
                        <input name="comment"
                               value="@entry.Comment"
                               maxlength="2000"
                               placeholder="@Localizer["Time_CommentPlaceholder"]" />
                    </label>

                    <button class="button button-secondary button-small"
                            type="submit">@Localizer["Time_SaveEntry"]</button>
                </form>
                <form method="post"
                      action="/projects/@Model.ProjectId/time/entries/@entry.Id/delete"
                      class="time-row-action">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="month" value="@Model.MonthKey" />
                    <button class="icon-button"
                            type="submit"
                            title="@Localizer["Time_DeleteEntry"]"
                            aria-label="@Localizer["Time_DeleteEntry"]">×</button>
                </form>
            </div>
        }

        <form method="post"
              action="/projects/@Model.ProjectId/time/days/@Model.Day.Id/entries/create"
              class="time-entry-form time-entry-new">
            @Html.AntiForgeryToken()
            <input type="hidden" name="month" value="@Model.MonthKey" />

            <label class="field time-entry-spent">
                <span>@Localizer["Time_TimeSpent"]</span>
                <input name="timeSpent"
                       placeholder="@Localizer["Time_TimeSpentPlaceholder"]"
                       title="@Localizer["Edit_TimeFormatHint"]"
                       required />
            </label>

            <label class="field time-entry-task">
                <span>@Localizer["Time_Task"]</span>
                <input type="hidden"
                       name="noteId"
                       value=""
                       data-time-task-note-id />
                <input name="taskTitle"
                       maxlength="240"
                       list="timeTaskOptions"
                       placeholder="@Localizer["Time_TaskPlaceholder"]"
                       autocomplete="off"
                       data-time-task-input />
            </label>

            <label class="field time-entry-comment">
                <span>@Localizer["Time_Comment"]</span>
                <input name="comment"
                       maxlength="2000"
                       placeholder="@Localizer["Time_CommentPlaceholder"]" />
            </label>

            <button class="button button-primary button-small"
                    type="submit">@Localizer["Time_AddEntry"]</button>
        </form>
    </div>
</article>
