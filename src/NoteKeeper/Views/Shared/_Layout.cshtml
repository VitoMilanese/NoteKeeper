@using System.Globalization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<AppResources> Localizer
@{
    var culture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var returnUrl = $"{Context.Request.PathBase}{Context.Request.Path}{Context.Request.QueryString}";
    var theme = string.Equals(Context.Request.Cookies["notekeeper_theme"], "light", StringComparison.OrdinalIgnoreCase)
        ? "light"
        : "dark";
}
<!DOCTYPE html>
<html lang="@culture" data-theme="@theme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <title>@(ViewData["Title"] ?? "NoteKeeper")</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <a class="brand" href="/" aria-label="@Localizer["Header_HomeAria"]">
            <span class="brand-mark">N</span>
            <span>NoteKeeper</span>
        </a>
        <nav class="top-nav">
            <button class="theme-toggle"
                    type="button"
                    data-theme-toggle
                    data-light-label="@Localizer["Theme_SwitchToLight"]"
                    data-dark-label="@Localizer["Theme_SwitchToDark"]"
                    title="@(theme == "dark" ? Localizer["Theme_SwitchToLight"] : Localizer["Theme_SwitchToDark"])"
                    aria-label="@(theme == "dark" ? Localizer["Theme_SwitchToLight"] : Localizer["Theme_SwitchToDark"])">
                <span aria-hidden="true" data-theme-icon>@(theme == "dark" ? "☀" : "☾")</span>
            </button>
            <form method="post" action="/language" class="language-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <label>
                    <span class="sr-only">@Localizer["Language_Label"]</span>
                    <select class="language-select" name="culture" aria-label="@Localizer["Language_Label"]" onchange="this.form.submit()">
                        <option value="en" selected="@(culture == "en" ? "selected" : null)">English</option>
                        <option value="it" selected="@(culture == "it" ? "selected" : null)">Italiano</option>
                        <option value="uk" selected="@(culture == "uk" ? "selected" : null)">Українська</option>
                    </select>
                </label>
            </form>
            <a class="button button-primary button-small" href="/notes/new">@Localizer["Common_NewNote"]</a>
        </nav>
    </header>

    <main class="page-shell">
        @RenderBody()
    </main>

    <dialog id="confirmDialog" class="app-dialog" aria-labelledby="confirmDialogTitle">
        <form method="dialog" class="app-dialog-card">
            <div class="app-dialog-icon" data-confirm-icon aria-hidden="true">!</div>
            <div class="app-dialog-copy">
                <h2 id="confirmDialogTitle" data-confirm-title>@Localizer["Dialog_ConfirmTitle"]</h2>
                <p data-confirm-message></p>
            </div>
            <div class="app-dialog-actions">
                <button class="button button-ghost" type="submit" value="cancel" data-confirm-cancel>@Localizer["Dialog_Cancel"]</button>
                <button class="button button-primary" type="submit" value="confirm" data-confirm-accept>@Localizer["Dialog_Confirm"]</button>
            </div>
        </form>
    </dialog>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
