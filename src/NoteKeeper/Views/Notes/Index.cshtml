@using Microsoft.Extensions.Localization
@inject IStringLocalizer<AppResources> Localizer
@model NoteListViewModel
@{
    ViewData["Title"] = Localizer["Index_PageTitle"].Value;
    var hasFilters = !string.IsNullOrWhiteSpace(Model.Query) || !string.IsNullOrWhiteSpace(Model.Tag);
    var selectedTags = Model.Tag
        .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .ToHashSet(StringComparer.OrdinalIgnoreCase);
}

<section class="hero-row">
    <div>
        <p class="eyebrow">@Localizer["Index_Eyebrow"]</p>
        <h1>@Localizer["Index_HeroTitle"]</h1>
        <p class="hero-copy">@Localizer["Index_HeroCopy"]</p>
    </div>
    <div class="hero-actions">
        <form method="post" action="/notes/import" enctype="multipart/form-data" class="import-note-form">
            @Html.AntiForgeryToken()
            <input id="noteImportInput"
                   type="file"
                   name="noteFile"
                   accept=".json,.notekeeper.json,application/json"
                   hidden
                   onchange="if (this.files.length) this.form.submit();" />
            <button class="button button-secondary" type="button" onclick="document.getElementById('noteImportInput').click();">
                @Localizer["Index_ImportNote"]
            </button>
        </form>
        <a class="button button-primary hero-action" href="/notes/new">@Localizer["Index_CreateNote"]</a>
    </div>
</section>

<section class="panel filter-panel">
    <form method="get" action="/" class="filter-grid">
        <label class="field search-field">
            <span>@Localizer["Index_Search"]</span>
            <input name="q" value="@Model.Query" placeholder="@Localizer["Index_SearchPlaceholder"]" autocomplete="off" />
        </label>

        <label class="field">
            <span>@Localizer["Index_Tag"]</span>
            <input name="tag" value="@Model.Tag" placeholder="@Localizer["Index_TagPlaceholder"]" autocomplete="off" />
        </label>

        <label class="field">
            <span>@Localizer["Index_Sort"]</span>
            <select name="sort">
                <option value="updated" selected="@(Model.Sort == "updated" ? "selected" : null)">@Localizer["Index_SortUpdated"]</option>
                <option value="created" selected="@(Model.Sort == "created" ? "selected" : null)">@Localizer["Index_SortCreated"]</option>
                <option value="title" selected="@(Model.Sort == "title" ? "selected" : null)">@Localizer["Index_SortTitle"]</option>
            </select>
        </label>

        <label class="field">
            <span>@Localizer["Index_Direction"]</span>
            <select name="dir">
                <option value="desc" selected="@(Model.Direction == "desc" ? "selected" : null)">@Localizer["Index_DirectionDesc"]</option>
                <option value="asc" selected="@(Model.Direction == "asc" ? "selected" : null)">@Localizer["Index_DirectionAsc"]</option>
            </select>
        </label>

        <button class="button button-secondary filter-submit" type="submit">@Localizer["Index_Apply"]</button>
        <a class="button button-ghost filter-reset"
           href="/?sort=@Uri.EscapeDataString(Model.Sort)&dir=@Uri.EscapeDataString(Model.Direction)">@Localizer["Index_Clear"]</a>
    </form>

    @if (Model.Tags.Count > 0)
    {
        <div class="tag-cloud" aria-label="@Localizer["Index_PopularTagsAria"]">
            @foreach (var item in Model.Tags)
            {
                var isStatusTag =
                    item.Name.Equals("active", StringComparison.OrdinalIgnoreCase) ||
                    item.Name.Equals("done", StringComparison.OrdinalIgnoreCase);
                <a class="tag-chip @(selectedTags.Contains(item.Name) ? "is-active" : "") @(isStatusTag ? "is-status-tag" : "")"
                   href="/?q=@Uri.EscapeDataString(Model.Query)&tag=@Uri.EscapeDataString(item.Name)&sort=@Model.Sort&dir=@Model.Direction">
                    #@item.Name <span>@item.Count</span>
                </a>
            }
        </div>
    }
</section>

<div class="list-heading">
    <h2>@(hasFilters ? Localizer["Index_Results"] : Localizer["Index_Notes"])</h2>
    <span>@Model.Notes.Count</span>
</div>

@if (Model.Notes.Count == 0)
{
    <section class="empty-state panel">
        <div class="empty-icon">✦</div>
        <h2>@(hasFilters ? Localizer["Index_NoResults"] : Localizer["Index_NoNotes"])</h2>
        <p>@(hasFilters ? Localizer["Index_NoResultsCopy"] : Localizer["Index_NoNotesCopy"])</p>
        <a class="button button-primary" href="/notes/new">@Localizer["Common_NewNote"]</a>
    </section>
}
else
{
    <section class="notes-grid">
        @foreach (var note in Model.Notes)
        {
            <article class="note-card">
                <a class="note-card-main" href="/notes/@note.Id">
                    <div class="note-card-topline">
                        <span>@Localizer["Index_BlockCount", note.BlockCount]</span>
                        <time class="js-local-time" datetime="@note.UpdatedAtUtc.ToString("O")">@note.UpdatedAtUtc.ToString("yyyy-MM-dd HH:mm")</time>
                    </div>
                    <h3>@note.Title</h3>
                    <p>@note.Preview</p>
                    @if (note.Tags.Count > 0)
                    {
                        <div class="note-tags">
                            @foreach (var noteTag in note.Tags.Take(6))
                            {
                                var isStatusTag =
                                    noteTag.Equals("active", StringComparison.OrdinalIgnoreCase) ||
                                    noteTag.Equals("done", StringComparison.OrdinalIgnoreCase);
                                <span class="@(isStatusTag ? "is-status-tag" : "")">#@noteTag</span>
                            }
                        </div>
                    }
                </a>
                <div class="note-card-actions">
                    <a class="icon-button" href="/notes/@note.Id" title="@Localizer["Index_Edit"]" aria-label="@Localizer["Index_Edit"]">✎</a>
                    <form method="post"
                          action="/notes/@note.Id/delete"
                          data-confirm-form
                          data-confirm-title="@Localizer["Index_DeleteDialogTitle"]"
                          data-confirm-message="@Localizer["Index_DeleteDialogMessage", note.Title]"
                          data-confirm-label="@Localizer["Index_Delete"]"
                          data-confirm-danger="true">
                        @Html.AntiForgeryToken()
                        <button class="icon-button danger" type="submit" title="@Localizer["Index_Delete"]" aria-label="@Localizer["Index_Delete"]">×</button>
                    </form>
                </div>
            </article>
        }
    </section>
}
