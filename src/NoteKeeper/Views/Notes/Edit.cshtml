        ["formatTextSize"] = Localizer["Editor_FormatTextSize"].Value,
        ["formatTextColor"] = Localizer["Editor_FormatTextColor"].Value,
        ["formatSizeSmall"] = Localizer["Editor_FormatSizeSmall"].Value,
        ["formatSizeNormal"] = Localizer["Editor_FormatSizeNormal"].Value,
        ["formatSizeLarge"] = Localizer["Editor_FormatSizeLarge"].Value,
        ["formatSizeExtraLarge"] = Localizer["Editor_FormatSizeExtraLarge"].Value,
        ["quoteContent"] = Localizer["Editor_QuoteContent"].Value,
        ["dividerDeleteHint"] = Localizer["Editor_DividerDeleteHint"].Value,
        ["systemEmoji"] = Localizer["Editor_SystemEmoji"].Value,
