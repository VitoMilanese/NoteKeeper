        ["uploadErrorStatus"] = Localizer["Editor_UploadErrorStatus"].Value,
        ["linkMustHttp"] = Localizer["Editor_LinkMustHttp"].Value,
        ["saving"] = Localizer["Editor_Saving"].Value,
        ["saveErrorStatus"] = Localizer["Editor_SaveErrorStatus"].Value,
        ["savedAt"] = Localizer["Editor_SavedAt"].Value,
        ["saveFailed"] = Localizer["Editor_SaveFailed"].Value,
        ["saveFailedToast"] = Localizer["Editor_SaveFailedToast"].Value,
        ["openLinkInvalid"] = Localizer["Editor_OpenLinkInvalid"].Value,
        ["formatBold"] = Localizer["Editor_FormatBold"].Value,
        ["formatItalic"] = Localizer["Editor_FormatItalic"].Value,
        ["formatUnderline"] = Localizer["Editor_FormatUnderline"].Value,
        ["formatStrike"] = Localizer["Editor_FormatStrike"].Value,
        ["formatCode"] = Localizer["Editor_FormatCode"].Value,
        ["formatHyperlink"] = Localizer["Editor_FormatHyperlink"].Value,
        ["hyperlinkDialogTitle"] = Localizer["Editor_HyperlinkDialogTitle"].Value,
        ["hyperlinkUrlLabel"] = Localizer["Editor_HyperlinkUrlLabel"].Value,
        ["hyperlinkApply"] = Localizer["Editor_HyperlinkApply"].Value,
        ["hyperlinkRemove"] = Localizer["Editor_HyperlinkRemove"].Value,
        ["hyperlinkCancel"] = Localizer["Editor_HyperlinkCancel"].Value,
        ["hyperlinkSelectText"] = Localizer["Editor_HyperlinkSelectText"].Value,
        ["hyperlinkInvalidUrl"] = Localizer["Editor_HyperlinkInvalidUrl"].Value,
        ["formatQuote"] = Localizer["Editor_FormatQuote"].Value,
        ["formatExpander"] = Localizer["Editor_FormatExpander"].Value,
        ["formatDivider"] = Localizer["Editor_FormatDivider"].Value,
        ["formatAddLineBelow"] = Localizer["Editor_FormatAddLineBelow"].Value,
        ["formatList"] = Localizer["Editor_FormatList"].Value,
        ["formatOrderedList"] = Localizer["Editor_FormatOrderedList"].Value,
        ["formatBulletList"] = Localizer["Editor_FormatBulletList"].Value,
        ["formatDashList"] = Localizer["Editor_FormatDashList"].Value,
        ["formatSymbols"] = Localizer["Editor_FormatSymbols"].Value,
        ["expanderSummary"] = Localizer["Editor_ExpanderSummary"].Value,
        ["expanderContent"] = Localizer["Editor_ExpanderContent"].Value,
        ["expanderDelete"] = Localizer["Editor_ExpanderDelete"].Value,
        ["unsavedDialogTitle"] = Localizer["Editor_UnsavedDialogTitle"].Value,
        ["unsavedDialogMessage"] = Localizer["Editor_UnsavedDialogMessage"].Value,
        ["leaveWithoutSaving"] = Localizer["Editor_LeaveWithoutSaving"].Value,
        ["deleteDialogTitle"] = Localizer["Index_DeleteDialogTitle"].Value,
